# Скопируйте в .env локально. В облаке задавайте переменные в панели хостинга — не коммитьте .env и не вставляйте токен в код.
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
# Optional: https://toncenter.com — raises rate limits
TONCENTER_API_KEY=
# Optional: https://www.trongrid.io/ — raises rate limits
TRONGRID_API_KEY=
# Optional polling interval in seconds
POLL_INTERVAL_SEC=45
# Optional: Redis для FSM (Railway: New → Redis → подключите к сервису бота — появится REDIS_URL)
REDIS_URL=
